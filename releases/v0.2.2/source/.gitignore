# ---- Go ----
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
/bin/
/dist/
build/bin/

# Go 工作区
go.work
go.work.sum

# ---- 前端(Phase 2 桌面壳) ----
# bindings 生成产物提交入库;依赖与构建产物不入库
frontend/node_modules/
frontend/dist/
# embed 目录只装前端构建产物(构建时从 frontend/dist 拷入,见 Taskfile)
cmd/agentdeck-desktop/assets/*
!cmd/agentdeck-desktop/assets/.gitkeep

# ---- 开发期临时目录 ----
# 侦察、实验、上游源码克隆（体积大，不入库）
_probe/
*.tmp
*.log

# ---- 编辑器 / IDE ----
.vscode/
.idea/
*.swp
*.swo
*~

# ---- 操作系统 ----
Thumbs.db
desktop.ini
.DS_Store

# ---- 本地环境 ----
.env
.env.local
*.local.json

# ---- 发布快照中的大文件 ----
# releases/ 保留 source/ 与 CHANGELOG.md，二进制产物上传 GitHub Releases
releases/**/*.exe
releases/**/*.msi
releases/**/*.zip
releases/**/*.tar.gz
releases/**/*.dmg
releases/**/*.pkg

# Python 脚本缓存(开发脚本)
__pycache__/

# ---- 本地构建缓存 ----
# GOCACHE 曾被指到仓库根下，留下 271 MB 的构建缓存；仓库里不该有它
.tmp-go-cache/
.tmp/
